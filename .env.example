# Single source of runtime configuration. Docker Compose reads .env automatically.
# First checkout: python scripts/env.py init (generates random credentials).
# Existing installations: retain the credentials already stored in persistent volumes.
# Do not commit .env. Only VITE_* values are public and included in the browser bundle.
# Use single quotes for literal values containing $ or #; keep values on one line.
# Published ports are host ports. POSTGRES_PORT/REDIS_PORT and service URLs are internal.
# If a host port changes, also update its *_PUBLIC_URL / VITE_API_PROXY_TARGET and Kafka's
# KAFKA_ADVERTISED_LISTENERS when changing KAFKA_EXTERNAL_PORT.

# Docker project and images
COMPOSE_PROJECT_NAME=commerceflow
COMPOSE_NETWORK_NAME=commerceflow
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine
KAFKA_IMAGE=confluentinc/cp-kafka:7.7.1
KAFKA_UI_IMAGE=provectuslabs/kafka-ui:latest
PGADMIN_IMAGE=dpage/pgadmin4:8.12
AUTH_SERVICE_IMAGE=commerceflow/auth-service:1.0.0
INVENTORY_SERVICE_IMAGE=commerceflow/inventory-service:1.0.0
ORDER_SERVICE_IMAGE=commerceflow/order-service:1.0.0
PAYMENT_SERVICE_IMAGE=commerceflow/payment-service:1.0.0
NOTIFICATION_SERVICE_IMAGE=commerceflow/notification-service:1.0.0
API_GATEWAY_IMAGE=commerceflow/api-gateway:1.0.0
WEB_IMAGE=commerceflow/web:1.0.0
PROMETHEUS_IMAGE=prom/prometheus:v2.54.1
GRAFANA_IMAGE=grafana/grafana:11.2.2

# Host ports and local development
POSTGRES_PUBLISHED_PORT=5432
REDIS_PUBLISHED_PORT=6379
KAFKA_PUBLISHED_PORT=9092
KAFKA_EXTERNAL_PORT=29092
KAFKA_UI_PORT=8090
PGADMIN_PORT=5050
AUTH_PORT=8081
INVENTORY_PORT=8083
ORDER_PORT=8082
PAYMENT_PORT=8084
NOTIFICATION_PORT=8085
GATEWAY_PORT=8080
WEB_PORT=3001
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
LOCAL_INFRA_HOST=localhost

# PostgreSQL databases and pools
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=commerceflow
POSTGRES_PASSWORD=
POSTGRES_DB=commerceflow
POSTGRES_INITDB_ARGS=--auth-host=scram-sha-256
AUTH_DB=commerceflow_auth
INVENTORY_DB=commerceflow_inventory
ORDER_DB=commerceflow_order
PAYMENT_DB=commerceflow_payment
NOTIFICATION_DB=commerceflow_notification
AUTH_DB_POOL_SIZE=15
INVENTORY_DB_POOL_SIZE=20
NOTIFICATION_DB_POOL_SIZE=15
ORDER_DB_POOL_SIZE=25
PAYMENT_DB_POOL_SIZE=20

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_MAXMEMORY=256mb
REDIS_MAXMEMORY_POLICY=allkeys-lru

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_NODE_ID=1
KAFKA_PROCESS_ROLES=broker,controller
KAFKA_CONTROLLER_QUORUM_VOTERS=1@kafka:29093
KAFKA_LISTENERS=PLAINTEXT://0.0.0.0:9092,CONTROLLER://0.0.0.0:29093,EXTERNAL://0.0.0.0:29092
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:9092,EXTERNAL://localhost:29092
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=PLAINTEXT:PLAINTEXT,CONTROLLER:PLAINTEXT,EXTERNAL:PLAINTEXT
KAFKA_INTER_BROKER_LISTENER_NAME=PLAINTEXT
KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1
KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS=0
KAFKA_AUTO_CREATE_TOPICS_ENABLE=true
KAFKA_LOG_RETENTION_HOURS=168
KAFKA_NUM_PARTITIONS=3
TOPIC_PARTITIONS=3
TOPIC_REPLICATION_FACTOR=1
KAFKA_CLUSTERS_0_NAME=commerceflow
KAFKA_CLUSTERS_0_BOOTSTRAPSERVERS=kafka:9092
DYNAMIC_CONFIG_ENABLED=true
TOPIC_RETENTION_MS=604800000

# JWT and administrator bootstrap
JWT_SECRET=
JWT_ISSUER=commerceflow
COMMERCEFLOW_BOOTSTRAP_ADMIN_ENABLED=true
COMMERCEFLOW_BOOTSTRAP_ADMIN_EMAIL=admin@commerceflow.io
COMMERCEFLOW_BOOTSTRAP_ADMIN_PASSWORD=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_CLOCK_SKEW=30s
COMMERCEFLOW_BOOTSTRAP_ADMIN_FULL_NAME='CommerceFlow Administrator'

# Public URLs and service connections
GATEWAY_PUBLIC_URL=http://localhost:8080
WEB_PUBLIC_URL=http://localhost:3001
INVENTORY_SERVICE_URL=http://inventory-service:8080
AUTH_SERVICE_URL=http://auth-service:8080
ORDER_SERVICE_URL=http://order-service:8080
PAYMENT_SERVICE_URL=http://payment-service:8080
NOTIFICATION_SERVICE_URL=http://notification-service:8080
GATEWAY_URL=http://api-gateway:8080
AUTH_PUBLIC_URL=http://localhost:8081
INVENTORY_PUBLIC_URL=http://localhost:8083
NOTIFICATION_PUBLIC_URL=http://localhost:8085
ORDER_PUBLIC_URL=http://localhost:8082
PAYMENT_PUBLIC_URL=http://localhost:8084
CORS_ALLOWED_ORIGINS=*

# Application runtime and workers
SPRING_PROFILES_ACTIVE=docker
TRACING_SAMPLE_RATE=1.0
JAVA_OPTS='-XX:MaxRAMPercentage=75.0 -XX:+UseG1GC -XX:+ExitOnOutOfMemoryError'
REQUIRE_VERIFIED_EMAIL=false
COMMERCEFLOW_BOOTSTRAP_DEMO_CATALOGUE_ENABLED=true
VIRTUAL_THREADS_ENABLED=true
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_RETENTION=7d
IDEMPOTENCY_RETENTION=7d
VERIFICATION_TOKEN_RETENTION=7d
RESERVATION_STALE_AFTER=2h
RESERVATION_SCAN_INTERVAL_MS=600000
RESERVATION_SCAN_BATCH_SIZE=200
ORDER_NUMBER_PREFIX=CF
ORDER_MAX_ITEMS=50
ORDER_READ_CACHE_TTL=2m
SAGA_STEP_TIMEOUT=2m
SAGA_MAX_ATTEMPTS=3
SAGA_SCAN_INTERVAL_MS=30000
SAGA_SCAN_BATCH_SIZE=100

# Payments and Stripe
PAYMENT_GATEWAY=SIMULATED
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_DECLINE_THRESHOLD=10000.00
PAYMENT_PROCESSING_DELAY_MS=0
PAYMENT_FAILURE_RATE=0.0
PAYMENT_CURRENCY=EUR
PAYMENT_METRICS_TARGET=payment-service:8080

# Email and notifications
NOTIFICATION_EMAIL_ENABLED=false
# SMTP or RESEND. The API key is only used by notification-service; never put it in VITE_*.
NOTIFICATION_EMAIL_PROVIDER=SMTP
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
NOTIFICATION_EMAIL_FROM=no-reply@commerceflow.io
SMTP_AUTH=true
SMTP_STARTTLS=true
NOTIFICATION_EMAIL_FROM_NAME=CommerceFlow
NOTIFICATION_EMAIL_REPLY_TO=
NOTIFICATION_DEFAULT_CHANNEL=EMAIL
NOTIFICATION_SENDER=no-reply@commerceflow.io
NOTIFICATION_MAX_RETRIES=3
NOTIFICATION_METRICS_TARGET=notification-service:8080

# Frontend public build settings
VITE_API_BASE_URL=
VITE_APP_NAME=CommerceFlow
VITE_STRIPE_PUBLISHABLE_KEY=
NGINX_RESOLVER=127.0.0.11
NGINX_CLIENT_MAX_BODY_SIZE=2m
VITE_API_TIMEOUT=15000
VITE_API_PROXY_TARGET=http://localhost:8080
VITE_DEV_PORT=5173
VITE_PREVIEW_PORT=4173

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@commerceflow.io
PGADMIN_DEFAULT_PASSWORD=
PGADMIN_CONFIG_SERVER_MODE=False
PGADMIN_SERVER_NAME=CommerceFlow
PGADMIN_SERVER_GROUP=Servers
PGADMIN_SSL_MODE=prefer
PGADMIN_SERVER_JSON_FILE=/tmp/servers.json
PGADMIN_REPLACE_SERVERS_ON_STARTUP=True

# Monitoring
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=
GF_USERS_ALLOW_SIGN_UP=false
GF_INSTALL_PLUGINS=
PROMETHEUS_URL=http://prometheus:9090
PROMETHEUS_SCRAPE_INTERVAL=15s
PROMETHEUS_EVALUATION_INTERVAL=15s
PROMETHEUS_SERVICE_SCRAPE_INTERVAL=10s
PROMETHEUS_ENVIRONMENT=local
GATEWAY_METRICS_TARGET=api-gateway:8080
AUTH_METRICS_TARGET=auth-service:8080
ORDER_METRICS_TARGET=order-service:8080
INVENTORY_METRICS_TARGET=inventory-service:8080
PROMETHEUS_RETENTION=15d

# Backup and demo scripts
BACKUP_DIR=./backups
RETENTION_DAYS=14
DEMO_PASSWORD=
SMOKE_PASSWORD=

# Kubernetes overrides
K8S_SPRING_PROFILES_ACTIVE=kubernetes
K8S_COMMERCEFLOW_BOOTSTRAP_ADMIN_ENABLED=false
K8S_COMMERCEFLOW_BOOTSTRAP_DEMO_CATALOGUE_ENABLED=false
K8S_REQUIRE_VERIFIED_EMAIL=false
K8S_GATEWAY_PUBLIC_URL=https://api.commerceflow.io
K8S_WEB_PUBLIC_URL=https://commerceflow.io
K8S_CORS_ALLOWED_ORIGINS=https://commerceflow.io,https://www.commerceflow.io
K8S_TRACING_SAMPLE_RATE=0.1
K8S_OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://otel-collector.observability:4318/v1/traces
K8S_KAFKA_CONTROLLER_QUORUM_VOTERS=1@kafka-0.kafka.commerceflow.svc.cluster.local:29093
K8S_KAFKA_LISTENERS=PLAINTEXT://0.0.0.0:9092,CONTROLLER://0.0.0.0:29093
K8S_KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:9092
K8S_KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=PLAINTEXT:PLAINTEXT,CONTROLLER:PLAINTEXT
K8S_INGRESS_HOST=api.commerceflow.io
K8S_REDIS_MAXMEMORY=512mb
K8S_AUTH_DB_POOL_SIZE=15
K8S_ORDER_DB_POOL_SIZE=15
K8S_INVENTORY_DB_POOL_SIZE=15
K8S_PAYMENT_DB_POOL_SIZE=15
K8S_NOTIFICATION_DB_POOL_SIZE=15
K8S_JAVA_OPTS='-XX:MaxRAMPercentage=75.0 -XX:+UseG1GC -XX:+ExitOnOutOfMemoryError -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/tmp'
