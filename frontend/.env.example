# Base URL the browser uses for API calls.
# Leave empty in development: Vite proxies /api to the gateway, keeping the app same-origin.
VITE_API_BASE_URL=

# Gateway the dev proxy forwards to.
VITE_API_PROXY_TARGET=http://localhost:8080

# Request timeout in milliseconds. The order saga is asynchronous, so no request should be slow;
# anything past this is a real problem, not a slow happy path.
VITE_API_TIMEOUT=15000

VITE_APP_NAME=CommerceFlow

# Stripe publishable key, when the backend runs on PAYMENT_GATEWAY=STRIPE.
# Safe in the bundle: it can only create payment attempts, never read or move money.
# Leave empty on the simulated acquirer — the payment form is then skipped entirely.
VITE_STRIPE_PUBLISHABLE_KEY=
